# ---------------------------------------------------------------------------
# TalentIA - Plantilla de variables de entorno
# Copiar este archivo como .env y ajustar segun el equipo de cada desarrollador
#   Linux / macOS : cp .env.example .env
#   Windows       : copy .env.example .env
# ---------------------------------------------------------------------------

# --- Motor LLM local (Ollama) ----------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:2b
# Debe coincidir con la variable OLLAMA_NUM_PARALLEL con la que se arranca Ollama.
# Limita cuantas inferencias simultaneas despacha el backend al modelo.
OLLAMA_NUM_PARALLEL=3
# Timeout por cada llamada al modelo (segundos). Subirlo en equipos sin GPU.
LLM_TIMEOUT_SEGUNDOS=180
# Intentos totales de inferencia por CV (1 = sin reintento ante JSON invalido)
LLM_MAX_REINTENTOS=2
# Modo "thinking" de la familia Qwen3. Mantener en false para salidas JSON limpias.
OLLAMA_THINK=false
# Tiempo que Ollama mantiene el modelo cargado en memoria entre peticiones
OLLAMA_KEEP_ALIVE=30m
# Ventana de contexto solicitada al modelo
LLM_NUM_CTX=8192
# Maximo de caracteres de CV enviados al modelo (evita desbordar el contexto)
LLM_MAX_CARACTERES_CV=12000

# --- Backend FastAPI --------------------------------------------------------
# La interfaz web se sirve en esta misma direccion. Streamlit queda como legado.
BACKEND_URL=http://localhost:8000
API_HOST=127.0.0.1
API_PORT=8000
# La web funciona en el mismo origen; no necesita CORS. "*" se ignora por seguridad.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Acceso al espacio compartido -------------------------------------------
# Crear la primera cuenta de administrador desde localhost al abrir la web.
# No hay usuario ni contrasena predeterminados. El administrador crea el equipo.
# Las sesiones caducan tras 12 horas y se invalidan en el servidor al cerrar sesion.
# Activar solo al servir mediante HTTPS (en HTTPS se activa automaticamente).
AUTH_COOKIE_SECURE=false

# --- Base de datos ----------------------------------------------------------
DATABASE_PATH=data/talentia.db
# Segundos que SQLite espera si la BD esta bloqueada por otro proceso concurrente
SQLITE_TIMEOUT=30

# --- Reglas de negocio ------------------------------------------------------
# Minimo de caracteres extraidos de un PDF para considerarlo legible
MIN_CARACTERES_PDF=50
# Tamano maximo aceptado por archivo PDF (MB)
MAX_PDF_MB=15

# --- Integraciones Google (opcionales) --------------------------------------
# Si credentials.json NO existe, el sistema entra automaticamente en MODO SIMULACION
# y registra el payload que se habria enviado, sin bloquear la demo.
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json
GOOGLE_CALENDAR_ID=primary
# Zona horaria IANA para los eventos de Google Calendar
TIMEZONE=America/Guayaquil
# Duracion por defecto de la entrevista (minutos)
DURACION_ENTREVISTA_MINUTOS=45
# Forzar modo simulacion aunque existan credenciales (util para ensayos de la defensa)
FORZAR_SIMULACION=false
# Remitente mostrado en el correo de invitacion
EMAIL_REMITENTE=me
NOMBRE_EMPRESA=TalentIA - Reclutamiento PYME
